#!/bin/sh

# Single-shot chrome launch. Keep-alive (for CDP) is handled by start_cdp.

: "${RUN_USER:=zzci}"
: "${RUN_HOME:=/home/$RUN_USER}"

rm -f "$RUN_HOME/.config/chrome/Singleton"* 2>/dev/null || true

exec env RUN_HOME="$RUN_HOME" \
    runuser -u "$RUN_USER" -- /bin/sh -c '
    . /build/bin/session_env
    export HOME="$RUN_HOME"

    /build/bin/wait_for_x || exit 1

    # Wait briefly for fcitx5 on the session bus: chrome binds its GTK IM
    # module at startup. Times out harmlessly when ZSRV_fcitx5 is disabled.
    for _ in $(seq 1 40); do
        dbus-send --session --print-reply --dest=org.freedesktop.DBus \
            / org.freedesktop.DBus.NameHasOwner string:org.fcitx.Fcitx5 \
            2>/dev/null | grep -q true && break
        sleep 0.3
    done

    . /build/bin/chrome_flags

    # CDP-only additions. --disable-hang-monitor suppresses the
    # "page unresponsive" dialog, which is right for automation and wrong
    # for the panel launcher, so it lives here and not in chrome_flags.
    exec google-chrome-stable $CHROME_FLAGS \
        --remote-debugging-port=19222 \
        --disable-hang-monitor \
        --disable-popup-blocking \
        --disable-prompt-on-repost
'
