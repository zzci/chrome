#!/bin/sh

# KasmVNC bootstrap. Privileged setup runs as root, then the X session
# (vncserver, openbox) is launched as $RUN_USER. dbus, fcitx5 and the
# panel are separate services that join this session as the same user.

set -e

: "${RUN_USER:=zzci}"

# As root: reconcile uid/gid + own home, clear stale X locks
/build/bin/init_user
killall Xvnc 2>/dev/null || true
rm -rf /tmp/.X1-lock /tmp/.X11-unix/X1 2>/dev/null || true

exec runuser -u "$RUN_USER" -- /bin/sh -c '
    set -e

    # First-run kasmvnc config — lives in the (mounted) home dir.
    # Auth is disabled at the server (-disableBasicAuth -SecurityTypes None);
    # the password file is just a placeholder kasmvncserver insists on.
    if [ ! -f "$HOME/.vnc/kasmvnc.yaml" ]; then
        mkdir -p "$HOME/.vnc"
        cp /build/config/kasmvnc.yaml "$HOME/.vnc/kasmvnc.yaml"
        printf "kasmpass\nkasmpass\n" | kasmvncpasswd -u "$USER" -w
        touch "$HOME/.vnc/.de-was-selected"
    fi
    # Backwards-compat: append the data_loss_prevention clipboard block
    # to legacy yaml files that predate it.
    if ! grep -q "^data_loss_prevention:" "$HOME/.vnc/kasmvnc.yaml"; then
        awk "/^data_loss_prevention:/{f=1} f" /build/config/kasmvnc.yaml >> "$HOME/.vnc/kasmvnc.yaml"
    fi
    # Backwards-compat: legacy yaml files pinned idle_timeout to 1800, which
    # drops the connection after 30 min without input — indistinguishable
    # from a frozen browser. Only the old literal is rewritten, so a value
    # the user chose deliberately is left alone.
    sed -i "s/^\\( *idle_timeout:\\) *1800 *\$/\\1 never/" "$HOME/.vnc/kasmvnc.yaml"

    # Hardware 3D when a DRI render node was passed through. Given on the
    # command line rather than written into kasmvnc.yaml so that a persisted
    # home does not pin a GPU setting the next container may not have.
    gpu_args=""
    dri_node=$(/build/bin/gpu_node)
    if [ -n "$dri_node" ]; then
        gpu_args="-hw3d -drinode $dri_node"
    fi

    vncserver -kill :1 -clean 2>/dev/null || true
    exec vncserver :1 -disableBasicAuth -SecurityTypes None -fg \
        -SendCutText 1 -AcceptCutText 1 -SendPrimary 1 \
        $gpu_args \
        -xstartup /build/bin/start_x
'
